# dependencies
node_modules

# next.js
.next/
out/
next-env.d.ts

# production
build/

# env
.env
.env.*
!.env.example

# testing
coverage/
playwright-report/
test-results/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# uploads locales (hojas escaneadas, PDFs generados)
storage/

# directorios temporales de verificación OMR (mkdtempSync)
omr-verify-*/
scanning-test-*/

# Assets binarios del seed (se generan localmente desde el PDF de referencia;
# ver prisma/assets/README.md). Solo se commitea el README.
prisma/assets/*
!prisma/assets/README.md

# omr-service (microservicio Python de detección OMR)
omr-service/.venv/
omr-service/__pycache__/
omr-service/**/__pycache__/
*.pyc

# Producción: el archivo real con secretos vive en el VPS. El template
# commiteado está en deploy/.env.prod.example.
.env.prod
.env.prod.local

# Override local de compose (útil en dev; nunca commitear).
docker-compose.override.yml

# Salidas del compilador de workers (regenerables con `pnpm tsc -p tsconfig.worker.json`).
dist-workers/

# Scripts de scratch locales (p. ej. para depurar geometría de hoja sin pasar
# por tests). NUNCA commitear.
.tmp-*.ts
.tmp-*.mjs
.tmp-*.sh
tmp/
public/templates/~$*
