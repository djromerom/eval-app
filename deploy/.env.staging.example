# ============================================================================
# eval-app — Variables de entorno de STAGING (test.ecognia.pro, mismo VPS)
#
# Gemelo de .env.prod.example con los overrides de staging. La copia operativa
# vive en el host como `/opt/eval/eval-app-staging/.env.staging` (chmod 600):
#
#     mkdir -p /opt/eval/eval-app-staging
#     cp deploy/.env.staging.example /opt/eval/eval-app-staging/.env.staging
#     chmod 600 /opt/eval/eval-app-staging/.env.staging
#     $EDITOR /opt/eval/eval-app-staging/.env.staging
#     # generar secretos nuevos con openssl (NO reutilizar los de prod)
#
# docker-compose.staging.yml carga este archivo con `env_file` por servicio.
# NUNCA commitear `.env.staging` con secretos reales.
#
# Diferencias con prod:
#   - DOMAIN/AUTH_URL apuntan a test.ecognia.pro
#   - POSTGRES_DB=eval_staging (DB separada en el mismo Postgres container)
#   - REDIS_URL apunta a db=1 (prod usa db=0) — aislamiento lógico
#   - BULLMQ_PREFIX=stg: — jobs viven bajo "bull:stg:" (sin pisarse con prod)
#   - IMAGE_TAG_SUFFIX=-staging — imágenes con tag "...-staging" en GHCR
#   - STORAGE_DIR apunta a /var/eval/storage-staging (volumen aparte)
#   - WEB_HOST_PORT=3001 — el nginx del host proxy_pass a este puerto
# ============================================================================

# ----------------------------------------------------------------------------
# Dominio y contacto
# ----------------------------------------------------------------------------
DOMAIN=test.ecognia.pro
CERTBOT_EMAIL=admin@ecognia.pro

# ----------------------------------------------------------------------------
# Postgres — DB separada del prod en el mismo container
# ----------------------------------------------------------------------------
POSTGRES_USER=eval
POSTGRES_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__
POSTGRES_DB=eval_staging
DATABASE_URL=postgresql://eval:__REPLACE_WITH_openssl_rand_base64_24__@postgres:5432/eval_staging?schema=public

# ----------------------------------------------------------------------------
# Redis — mismo container que prod, pero DB lógica distinta (db=1)
# BullMQ usa BULLMQ_PREFIX=stg: → jobs viven bajo "bull:stg:omr-scan" etc.
# ----------------------------------------------------------------------------
REDIS_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__
REDIS_URL=redis://:__REPLACE_WITH_openssl_rand_base64_24__@redis:6379/1
BULLMQ_PREFIX=stg:

# ----------------------------------------------------------------------------
# Imagen GHCR pineada por SHA + sufijo de staging (compuesto por cd.sh)
# ----------------------------------------------------------------------------
GHCR_OWNER=djromerom
GHCR_IMAGE_BASE=ghcr.io
IMAGE_TAG_SUFFIX=-staging

# ----------------------------------------------------------------------------
# Compose env_file path. docker-compose.prod.yml usa
# `env_file: ${ENV_FILE:-.env.prod}`. Después de `set -a; . .env.staging`,
# esta var queda exportada y compose lee .env.staging en lugar de .env.prod.
# En prod queda como .env.prod (default en compose).
# ----------------------------------------------------------------------------
ENV_FILE=.env.staging

# ----------------------------------------------------------------------------
# Web host port (loopback del VPS — el nginx del host hace proxy_pass a esto)
# ----------------------------------------------------------------------------
WEB_HOST_PORT=3001

# ----------------------------------------------------------------------------
# Auth.js
# - AUTH_URL: debe ser https://test.ecognia.pro (NO prod, NO localhost)
# ----------------------------------------------------------------------------
AUTH_SECRET=__REPLACE_WITH_openssl_rand_base64_32__
AUTH_URL=https://test.ecognia.pro

# OAuth — agregar redirect URIs para test.ecognia.pro en cada provider:
#   Google: https://test.ecognia.pro/api/auth/callback/google
#   Microsoft: https://test.ecognia.pro/api/auth/callback/microsoft-entra-id
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ----------------------------------------------------------------------------
# Firma HMAC de códigos QR (hojas de respuesta). Distinto de prod para que
# QRs generados en staging NO sean válidos en prod (security boundary).
# ----------------------------------------------------------------------------
QR_SIGNING_SECRET=__REPLACE_WITH_openssl_rand_hex_32__

# ----------------------------------------------------------------------------
# Almacenamiento local — volumen `storage-staging`, NO el de prod.
# ----------------------------------------------------------------------------
STORAGE_DIR=/var/eval/storage-staging

# ----------------------------------------------------------------------------
# Editor de preguntas (mismo rango A–H que prod)
# ----------------------------------------------------------------------------
EVAL_DEFAULT_OPTIONS=4
EVAL_MAX_OPTIONS=8

# ----------------------------------------------------------------------------
# Microservicio OMR Python (mismo nombre de servicio dentro del compose)
# ----------------------------------------------------------------------------
OMR_SERVICE_URL=http://omr-service:8000

# ----------------------------------------------------------------------------
# Timeouts de generación de PDF (la cadena worker → app → nginx).
# Mismos valores que prod; NGINX_PROXY_READ_TIMEOUT tiene que superar
# PDF_QUEUE_WAIT_MS (lo valida deploy/scripts/render-nginx-conf.sh).
# ----------------------------------------------------------------------------
PDF_RENDER_TIMEOUT_MS=600000
PDF_QUEUE_WAIT_MS=900000
PDF_IMAGE_WAIT_MS=120000
NGINX_PROXY_CONNECT_TIMEOUT=60s
NGINX_PROXY_SEND_TIMEOUT=1200s
NGINX_PROXY_READ_TIMEOUT=1200s

# ----------------------------------------------------------------------------
# SMTP (opcional — staging puede usar el mismo relay o vacío para no enviar)
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecognia.pro
