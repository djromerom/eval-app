# ============================================================================
# Renovación automática de certificados Let's Encrypt para eval-app
#
# Instalar en el host con:
#   sudo cp deploy/cron/eval-certbot /etc/cron.d/eval-certbot
#   sudo chmod 644 /etc/cron.d/eval-certbot
#   sudo systemctl restart cron
#
# Cada noche a las 03:17 (off-minute para evitar pico :00/:30):
#   1. corre certbot renew
#   2. si rotó algún cert, hace `nginx -s reload` dentro del contenedor nginx
#
# Requiere: docker compose plugin + que el repo esté en /opt/eval/eval-app.
# ============================================================================

# m  h dom mon dow user  command
17 3 * * * root cd /opt/eval/eval-app && /usr/local/bin/docker compose -f docker-compose.prod.yml run --rm certbot renew --quiet >> /var/log/eval-certbot.log 2>&1 && /usr/local/bin/docker compose -f docker-compose.prod.yml exec -T nginx nginx -s reload >> /var/log/eval-certbot.log 2>&1