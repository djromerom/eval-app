# ============================================================================
# eval-app — Variables de entorno de PRODUCCIÓN (VPS único: ecognia.pro)
#
# Este archivo es el TEMPLATE commiteado (sin secretos reales). La copia
# operativa vive en el host como `.env.prod` con permisos 600:
#
#     cp deploy/.env.prod.example .env.prod
#     chmod 600 .env.prod
#     # luego editar con tus secretos generados con openssl
#
# docker-compose.prod.yml carga este archivo con `env_file` por servicio.
# NUNCA commitear `.env.prod` con secretos reales.
# ============================================================================

# ----------------------------------------------------------------------------
# Dominio y contacto
# ----------------------------------------------------------------------------
DOMAIN=ecognia.pro
CERTBOT_EMAIL=admin@ecognia.pro

# ----------------------------------------------------------------------------
# Postgres (servicio `postgres` dentro del compose)
# El DATABASE_URL debe apuntar al nombre del servicio, NO a localhost.
# ----------------------------------------------------------------------------
POSTGRES_USER=eval
POSTGRES_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__
POSTGRES_DB=eval
DATABASE_URL=postgresql://eval:__REPLACE_WITH_openssl_rand_base64_24__@postgres:5432/eval?schema=public

# ----------------------------------------------------------------------------
# Redis (servicio `redis`). REDIS_PASSWORD se inyecta al servicio vía env_file
# y se usa en REDIS_URL con la sintaxis redis://:password@host:port.
# ----------------------------------------------------------------------------
REDIS_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__
REDIS_URL=redis://:__REPLACE_WITH_openssl_rand_base64_24__@redis:6379

# ----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# - AUTH_SECRET: clave de sesión. Generar con `openssl rand -base64 32`.
# - AUTH_URL: URL PÚBLICA de la app. CRÍTICO — debe ser https://ecognia.pro,
#   NO http://localhost:3000 ni http://web:3000. Si está mal, el worker PDF
#   falla con "Acceso a /print rechazado" porque genera el token contra la
#   URL equivocada y el middleware del print lo rechaza.
# ----------------------------------------------------------------------------
AUTH_SECRET=__REPLACE_WITH_openssl_rand_base64_32__
AUTH_URL=https://ecognia.pro

# OAuth (opcional — dejar vacíos para deshabilitar)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ----------------------------------------------------------------------------
# Firma HMAC de códigos QR (hojas de respuesta).
# ----------------------------------------------------------------------------
QR_SIGNING_SECRET=__REPLACE_WITH_openssl_rand_hex_32__

# ----------------------------------------------------------------------------
# Almacenamiento local (logos institucionales, hojas escaneadas, PDFs).
# El contenedor `web` y los workers montan el volumen `storage` aquí.
# NO usar rutas relativas: dentro del contenedor el CWD es /.next/standalone.
# ----------------------------------------------------------------------------
STORAGE_DIR=/var/eval/storage

# ----------------------------------------------------------------------------
# Editor de preguntas (rango de opciones A–H, máximo absoluto = 8).
# ----------------------------------------------------------------------------
EVAL_DEFAULT_OPTIONS=4
EVAL_MAX_OPTIONS=8

# ----------------------------------------------------------------------------
# SMTP (envío de invitaciones a docentes). Si están vacíos, la app NO envía
# correos y los invites quedan en un log interno.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecognia.pro

# ----------------------------------------------------------------------------
# Timeouts de generación de PDF (la cadena worker → app → nginx).
#
#   PDF_RENDER_TIMEOUT_MS  Chromium cargando la página /print (worker PDF y
#                          captura de geometría de la hoja).
#   PDF_QUEUE_WAIT_MS      Espera de la request HTTP por el job BullMQ.
#   PDF_IMAGE_WAIT_MS      Espera del PrintImageSizer del cliente.
#   NGINX_PROXY_*          Timeouts del reverse proxy del host; los aplica
#                          deploy/scripts/render-nginx-conf.sh (nginx no lee
#                          el env solo).
#
# REGLA: NGINX_PROXY_READ_TIMEOUT tiene que ser MAYOR que PDF_QUEUE_WAIT_MS
# (si no, nginx corta la respuesta antes que la app → 504 con HTML en vez del
# JSON de la app). El script valida esa relación y no escribe si no se cumple.
# ----------------------------------------------------------------------------
PDF_RENDER_TIMEOUT_MS=600000
PDF_QUEUE_WAIT_MS=900000
PDF_IMAGE_WAIT_MS=120000
NGINX_PROXY_CONNECT_TIMEOUT=60s
NGINX_PROXY_SEND_TIMEOUT=1200s
NGINX_PROXY_READ_TIMEOUT=1200s

# ----------------------------------------------------------------------------
# Compose env_file path. docker-compose.prod.yml usa
# `env_file: ${ENV_FILE:-.env.prod}`. Por defecto .env.prod; en staging el
# cd-wrapper.sh source-ea .env.staging que exporta `ENV_FILE=.env.staging`.
# ----------------------------------------------------------------------------
ENV_FILE=.env.prod