# ===== Base de datos =====
# Local: docker compose up -d
# Rol DUEÑO (eval): corre migraciones y, hoy, la app. Omite RLS.
DATABASE_URL="postgresql://eval:eval@localhost:5432/eval?schema=public"
# Producción (opcional): rol restringido que SÍ aplica las políticas RLS
# multi-tenant (creado por la migración enable_rls). La app fijará
# `app.current_institution` por request. Ver src/shared/infrastructure/db/tenant-context.ts
# DATABASE_URL_APP="postgresql://eval_app:eval_app@localhost:5432/eval?schema=public"
# Puertos del host para docker-compose (cámbialos si 5432/6379 están ocupados
# por otros contenedores; recuerda reflejarlos en DATABASE_URL/REDIS_URL).
POSTGRES_PORT="5432"
REDIS_PORT="6379"

# ===== Auth.js =====
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
# URL pública de la app (en dev: http://localhost:3000)
AUTH_URL="http://localhost:3000"

# OAuth Google (opcional en dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth Microsoft Entra ID (opcional en dev)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ===== Redis (cola BullMQ para escaneo OMR y PDFs) =====
REDIS_URL="redis://localhost:6379"

# ===== Almacenamiento local (imágenes escaneadas, PDFs) =====
STORAGE_DIR="./storage"

# ===== Firma HMAC de códigos QR =====
# Clave maestra; la clave efectiva se deriva por institución.
# Generar con: openssl rand -hex 32
QR_SIGNING_SECRET=""
