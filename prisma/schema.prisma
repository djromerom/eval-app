// Modelo de datos — ver REQUERIMIENTOS_v2.md §4.
// Convenciones: UUID v7 (ordenable), timestamps automáticos,
// multi-tenant: toda tabla de negocio lleva institutionId + índice compuesto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== TENANT ==========

model Institution {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique // para subdominio
  code      String   @unique
  logo      String?
  // Tema visual institucional para la impresión del cuadernillo. Ver
  // src/modules/theme/domain/theme.ts (zod schema) y el helper mergeTheme()
  // que combina este JSON con el de Evaluation.theme (override por eval).
  theme     Json?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  courses       Course[]
  subjects      Subject[] // catálogo propio (null en Subject = global)
  groups        Group[]
  periods       Period[]
  students      Student[]
  evaluations   Evaluation[]
  questionBank  QuestionBank[]
  templates     EvaluationTemplate[]
  scanBatches   ScanBatch[]
  bundles       EvaluationBundle[]
}

// ========== AUTH & USERS ==========

model User {
  id                   String      @id @default(uuid(7)) @db.Uuid
  email                String      @unique
  name                 String
  password             String? // hash bcrypt — solo para provider credentials
  image                String?
  emailVerified        DateTime?
  inviteToken          String? // bcrypt del token de invitación
  inviteTokenExpiresAt DateTime?
  // sha256 del token de recuperación de contraseña. @unique permite lookup
  // directo por token (URL sin email en la query string). Set a null tras
  // aplicar el reset o cuando expira.
  passwordResetToken      String?   @unique
  passwordResetExpiresAt  DateTime?
  institutionId        String      @db.Uuid
  institution          Institution @relation(fields: [institutionId], references: [id])
  isActive             Boolean     @default(true)
  deletedAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  roles          UserRole[]
  accounts       Account[]
  teacherProfile Teacher?
  evaluations    Evaluation[]
  questionBank   QuestionBank[]
  templates      EvaluationTemplate[]
  scanBatches    ScanBatch[]
  bundlesCreated EvaluationBundle[]   @relation("BundleCreatedBy")
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([institutionId])
}

// Requerido por @auth/prisma-adapter para vincular cuentas OAuth (Google/Microsoft)
model Account {
  id                String  @id @default(uuid(7)) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleType
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
}

enum RoleType {
  SUPER_ADMIN
  ECU_MASTER
  COORDINATOR
  TEACHER
}

model Teacher {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  idType    String // C.C., C.E.
  idNumber  String
  phone     String?
  createdAt DateTime @default(now())

  subjectAssignments TeacherSubjectAssignment[]
}

// ========== ACADEMIC STRUCTURE ==========

model AcademicYear {
  id            String      @id @default(uuid(7)) @db.Uuid
  year          Int // 2025, 2026
  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id])
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  courses     Course[]
  periods     Period[]
  evaluations Evaluation[]

  @@unique([institutionId, year])
  @@index([institutionId])
}

model Course {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String // "8°", "11°"
  code           String
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  institutionId  String       @db.Uuid
  institution    Institution  @relation(fields: [institutionId], references: [id])
  createdAt      DateTime     @default(now())

  subjects CourseSubject[]
  groups   Group[]
  bundles  EvaluationBundle[]

  @@index([institutionId, academicYearId])
}

model Subject {
  id              String       @id @default(uuid(7)) @db.Uuid
  name            String // "Matemáticas", "Física"
  code            String
  icon            String?
  institutionId   String?      @db.Uuid // null = catálogo global
  institution     Institution? @relation(fields: [institutionId], references: [id])
  // Jerarquía de 2 niveles para la tabla de áreas de la portada del compendio
  // (Ciencias Naturales ⊃ Biología/Física/Química). Si isArea=true, este subject
  // es solo agrupador — no se imprime como subject evaluable. Si tiene
  // parentSubjectId, debe ser un subject hoja (isArea=false). Ver
  // SubjectRepository.create en src/modules/academic/ para validación de ciclos.
  parentSubjectId String?      @db.Uuid
  parentSubject   Subject?     @relation("SubjectHierarchy", fields: [parentSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Subject[]    @relation("SubjectHierarchy")
  isArea          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  courses      CourseSubject[]
  questionBank QuestionBank[]

  @@index([institutionId])
  @@index([institutionId, parentSubjectId])
}

model CourseSubject {
  id        String  @id @default(uuid(7)) @db.Uuid
  courseId  String  @db.Uuid
  course    Course  @relation(fields: [courseId], references: [id])
  subjectId String  @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id])

  teachers    TeacherSubjectAssignment[]
  evaluations Evaluation[]
  templates   EvaluationTemplate[]

  @@unique([courseId, subjectId])
  @@index([courseId])
  @@index([subjectId])
}

model TeacherSubjectAssignment {
  id              String        @id @default(uuid(7)) @db.Uuid
  teacherId       String        @db.Uuid
  teacher         Teacher       @relation(fields: [teacherId], references: [id])
  courseSubjectId String        @db.Uuid
  courseSubject   CourseSubject @relation(fields: [courseSubjectId], references: [id])

  @@unique([teacherId, courseSubjectId])
  @@index([teacherId])
  @@index([courseSubjectId])
}

model Group {
  id            String      @id @default(uuid(7)) @db.Uuid
  name          String // "2-01", "11-03"
  courseId      String      @db.Uuid
  course        Course      @relation(fields: [courseId], references: [id])
  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())

  students    Student[]
  evaluations EvaluationGroup[]

  @@index([courseId])
  @@index([institutionId])
}

model Period {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String // "I Periodo", ..., "Final", "Diagnóstico"
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  institutionId  String       @db.Uuid
  institution    Institution  @relation(fields: [institutionId], references: [id])
  startDate      DateTime
  endDate        DateTime
  order          Int // 1, 2, 3, 4
  createdAt      DateTime     @default(now())

  evaluations Evaluation[]

  @@unique([institutionId, academicYearId, name])
  @@index([institutionId, academicYearId])
}

model Student {
  id             String      @id @default(uuid(7)) @db.Uuid
  name           String
  idType         String // T.I., C.C., NUI, R.C.
  idNumber       String
  code           String // código estudiantil único por institución (va en el QR)
  groupId        String      @db.Uuid
  group          Group       @relation(fields: [groupId], references: [id])
  institutionId  String      @db.Uuid
  institution    Institution @relation(fields: [institutionId], references: [id])
  enrollmentYear Int
  isActive       Boolean     @default(true)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  answerSheets AnswerSheet[]
  codeHistory  StudentCodeHistory[]

  @@unique([institutionId, code])
  @@index([groupId])
  @@index([institutionId])
}

// Si un estudiante cambia de código, el QR viejo debe seguir funcionando
model StudentCodeHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  oldCode   String
  newCode   String
  changedAt DateTime @default(now())

  @@index([studentId])
}

// ========== EVALUATIONS ==========

model Evaluation {
  id              String              @id @default(uuid(7)) @db.Uuid
  title           String
  description     String?
  version         Int                 @default(1)
  courseSubjectId String              @db.Uuid
  courseSubject   CourseSubject       @relation(fields: [courseSubjectId], references: [id])
  periodId        String?             @db.Uuid // null = no ligada a periodo (final, diagnóstico)
  period          Period?             @relation(fields: [periodId], references: [id])
  academicYearId  String              @db.Uuid
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id])
  institutionId   String              @db.Uuid
  institution     Institution         @relation(fields: [institutionId], references: [id])
  teacherId       String              @db.Uuid
  teacher         User                @relation(fields: [teacherId], references: [id])
  status          DraftStatus         @default(DRAFT)
  bookletNumber   Int? // null = único; 1, 2, 3… para múltiples cuadernillos
  totalQuestions  Int                 @default(0)
  // Duración estimada de la evaluación en minutos. Nullable: si es null, la
  // portada del compendio cae al cálculo heurístico (totalQuestions *
  // DEFAULT_MINUTES_PER_QUESTION). Capturado por el docente en el panel
  // Settings de la evaluation; editable mientras esté en DRAFT.
  durationMinutes Int?
  templateId      String?             @db.Uuid
  template        EvaluationTemplate? @relation(fields: [templateId], references: [id])
  // Override del tema institucional para esta evaluación. Se combina con
  // Institution.theme en runtime; cualquier campo ausente cae al institucional
  // y luego al default. Ver src/modules/theme/domain/theme.ts.
  theme           Json?
  parentVersionId String?             @db.Uuid // versión anterior (historial inmutable)
  parentVersion   Evaluation?         @relation("VersionHistory", fields: [parentVersionId], references: [id])
  revisions       Evaluation[]        @relation("VersionHistory")
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sections     EvaluationSection[]
  answerSheets AnswerSheet[]
  groups       EvaluationGroup[]
  scanBatches  ScanBatch[]
  bundleItems  EvaluationBundleItem[]

  @@index([courseSubjectId, academicYearId])
  @@index([institutionId, status])
  @@index([teacherId])
}

enum DraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

model EvaluationGroup {
  evaluationId String     @db.Uuid
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  groupId      String     @db.Uuid
  group        Group      @relation(fields: [groupId], references: [id])

  @@id([evaluationId, groupId])
}

model EvaluationSection {
  id           String     @id @default(uuid(7)) @db.Uuid
  evaluationId String     @db.Uuid
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  title        String?
  content      Json // TipTap JSON (rich text con KaTeX, imágenes, tablas)
  order        Int
  createdAt    DateTime   @default(now())

  questions Question[]

  @@index([evaluationId, order])
}

model Question {
  id            String            @id @default(uuid(7)) @db.Uuid
  sectionId     String            @db.Uuid
  section       EvaluationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  number        Int
  text          Json // TipTap JSON (puede contener KaTeX)
  image         String?
  correctAnswer String // "A", "B", "C", "D"
  justification String? // clave de respuestas, no se imprime en cartilla
  weight        Float             @default(1.0)
  soloLevel     SoloLevel?
  menComponent  String?
  competency    String?
  evidence      String?
  bankOriginId  String?           @db.Uuid // si se importó del banco (copia independiente)
  createdAt     DateTime          @default(now())

  options QuestionOption[]
  answers StudentAnswer[]

  @@index([sectionId, number])
}

model QuestionOption {
  id         String   @id @default(uuid(7)) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key        String // "A", "B", "C", "D"
  text       Json // TipTap JSON

  @@index([questionId])
}

enum SoloLevel {
  UNI_ESTRUCTURAL
  MULTIESTRUCTURAL
  RELACIONAL
  ABSTRACTO_EXTENDIDO
}

// ========== QUESTION BANK ==========

model QuestionBank {
  id            String             @id @default(uuid(7)) @db.Uuid
  text          Json // TipTap JSON
  image         String?
  correctAnswer String
  justification String?
  soloLevel     SoloLevel?
  menComponent  String?
  competency    String?
  evidence      String?
  difficulty    QuestionDifficulty @default(MEDIUM)
  subjectId     String             @db.Uuid
  subject       Subject            @relation(fields: [subjectId], references: [id])
  institutionId String             @db.Uuid
  institution   Institution        @relation(fields: [institutionId], references: [id])
  createdBy     String             @db.Uuid
  creator       User               @relation(fields: [createdBy], references: [id])
  tags          String[]
  isPersonal    Boolean            @default(false) // true = solo visible para el creador
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  options QuestionBankOption[]

  @@index([institutionId, subjectId])
  @@index([createdBy])
}

model QuestionBankOption {
  id             String       @id @default(uuid(7)) @db.Uuid
  questionBankId String       @db.Uuid
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  key            String // "A", "B", "C", "D"
  text           Json // TipTap JSON

  @@index([questionBankId])
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// ========== EVALUATION TEMPLATES ==========

model EvaluationTemplate {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  description     String?
  courseSubjectId String        @db.Uuid
  courseSubject   CourseSubject @relation(fields: [courseSubjectId], references: [id])
  institutionId   String        @db.Uuid
  institution     Institution   @relation(fields: [institutionId], references: [id])
  createdBy       String        @db.Uuid
  creator         User          @relation(fields: [createdBy], references: [id])
  structure       Json // [{title, numQuestions, order}]
  createdAt       DateTime      @default(now())

  evaluations Evaluation[]

  @@index([institutionId])
}

// ========== EVALUATION BUNDLES (COMPENDIOS) ==========
// Agrupación de N evaluations en un solo artefacto imprimible (cuadernillo)
// con hoja de respuestas unificada. Sprint 1 del módulo compendios.
// Ver docs/compendios.md.

enum BundleStatus {
  DRAFT // editable: items, nombre, bookletNumber, theme
  READY // sellado: listo para imprimir; contenido inmutable
}

model EvaluationBundle {
  id              String       @id @default(uuid(7)) @db.Uuid
  institutionId   String       @db.Uuid
  institution     Institution  @relation(fields: [institutionId], references: [id])
  name            String // "Simulacro ICFES — Periodo I"
  bookletNumber   Int? // correlativo por institución (opcional; único si definido)
  // Curso al que pertenece el compendio. Opcional: null = compendio
  // cross-course (simulacro institucional multi-grado). Si está definido,
  // TODOS los items deben ser evaluations de ese curso (validado en los use
  // cases CreateBundle / AddEvaluationToBundle / UpdateBundle). La portada
  // del PDF preimprime el grado en lugar de dejar la línea en blanco.
  courseId        String?      @db.Uuid
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  status          BundleStatus @default(DRAFT)
  // Override del tema institucional. Mismo shape que Evaluation.theme; se
  // combina con Institution.theme en runtime. Ver src/modules/theme/.
  theme           Json?
  // Geometría OMR de la hoja de respuestas, MEDIDA del render real
  // (ver modules/printing/domain/sheet-template.ts). Se captura de forma
  // perezosa la primera vez que se escanea una hoja del compendio y se
  // reutiliza para las demás: la rejilla depende del compendio, no del
  // estudiante.
  //
  // OJO — no basta con cachearla: si el layout de impresión cambia después
  // de imprimir, esta plantilla deja de describir el papel que tiene el
  // docente en la mano. Por eso el escaneo NO confía a ciegas en ella; mide
  // la calidad de la alineación (`SheetAlignment`) y manda la hoja a
  // revisión en vez de calificarla mal en silencio. Un caso real: una hoja
  // impresa con reparto de columnas 40/40/30 se escaneó cuando el código ya
  // repartía 37/37/36.
  sheetTemplate   Json?
  // Cuándo se capturó `sheetTemplate`, para poder invalidarla a mano.
  sheetTemplateAt DateTime?
  createdById     String       @db.Uuid
  createdBy       User         @relation("BundleCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items       EvaluationBundleItem[]
  sheets      AnswerSheet[]
  scanBatches ScanBatch[]

  @@unique([institutionId, bookletNumber])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, courseId])
}

model EvaluationBundleItem {
  id           String           @id @default(uuid(7)) @db.Uuid
  bundleId     String           @db.Uuid
  bundle       EvaluationBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  evaluationId String           @db.Uuid
  evaluation   Evaluation       @relation(fields: [evaluationId], references: [id])
  // Posición 1-based en el compendio. Controla el orden de impresión de los
  // booklet y el orden de las secciones en la portada.
  order        Int

  answers StudentAnswer[]

  @@unique([bundleId, evaluationId]) // una eval no se repite en el mismo bundle
  @@unique([bundleId, order]) // un solo item por posición
  @@index([evaluationId])
}

// ========== ANSWER SHEETS & GRADING ==========

// Lote de escaneo: hasta 200 hojas por carga, procesado asíncronamente (BullMQ).
// Una hoja escaneada pertenece a UN evaluation legacy o a UN bundle (compendio);
// lo mismo aplica al batch que la agrupa. La invariante "exactamente uno no-nulo"
// vive en el use case (no se enforza a nivel DB para no romper hojas legacy).
model ScanBatch {
  id              String            @id @default(uuid(7)) @db.Uuid
  institutionId   String            @db.Uuid
  institution     Institution       @relation(fields: [institutionId], references: [id])
  evaluationId    String?           @db.Uuid
  evaluation      Evaluation?       @relation(fields: [evaluationId], references: [id])
  bundleId        String?           @db.Uuid
  bundle          EvaluationBundle? @relation(fields: [bundleId], references: [id])
  uploadedBy      String            @db.Uuid
  uploader        User              @relation(fields: [uploadedBy], references: [id])
  status          ScanStatus        @default(PENDING)
  totalSheets     Int               @default(0)
  processedSheets Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sheets AnswerSheet[]

  @@index([institutionId])
  @@index([evaluationId])
  @@index([bundleId])
}

model AnswerSheet {
  id                  String            @id @default(uuid(7)) @db.Uuid
  // Hoja pertenece a UN evaluation legacy o a UN bundle (compendio). Sprint 1+
  // migra el camino canónico a bundle (incluso N=1); hojas legacy (solo
  // evaluationId) siguen funcionando pero la app nueva ya no las crea.
  evaluationId        String?           @db.Uuid
  // Hojas legacy (pre-Sprint 1) apuntan a una evaluation. Al borrar esa
  // evaluation el FK queda en NULL (no en CASCADE) para conservar auditoría
  // de la hoja escaneada.
  evaluation          Evaluation?       @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  bundleId            String?           @db.Uuid
  bundle              EvaluationBundle? @relation(fields: [bundleId], references: [id])
  studentId           String?           @db.Uuid // null si es hoja genérica o QR no identificable
  student             Student?          @relation(fields: [studentId], references: [id])
  studentName         String? // respaldo: nombre escrito a mano en la hoja
  studentCode         String? // respaldo: código escrito en la hoja
  qrContent           String // contenido completo del QR (JSON)
  qrSignature         String // HMAC-SHA256 para verificar integridad
  scannedImage        String? // ruta de la imagen escaneada original
  processedImage      String? // ruta de la imagen procesada (binaria, con detecciones)
  scanBatchId         String?           @db.Uuid
  scanBatch           ScanBatch?        @relation(fields: [scanBatchId], references: [id])
  status              ScanStatus        @default(PENDING)
  score               Float?
  totalCorrect        Int?
  totalQuestions      Int?
  // Sprint 9 OMR auto-detect: geometría inferida por el detector de burbujas.
  // Permite a la UI matriz renderizar el grid sin re-detectar. null = legacy
  // 1-col o detección omitida.
  gridLayout          Json?
  // Confianza mediana de la detección 0..1 (densidad de componentes
  // supervivientes). Útil para diagnóstico y para ajustar thresholds.
  detectionConfidence Float?
  reviewedBy          String?           @db.Uuid // usuario que revisó manualmente
  reviewedAt          DateTime?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  answers StudentAnswer[]

  // Invariante (validada en use cases, no en DB): exactamente uno de
  // evaluationId / bundleId no nulo.
  @@index([evaluationId, status])
  @@index([bundleId, status])
  @@index([studentId])
  @@index([scanBatchId])
}

enum ScanStatus {
  PENDING // sin escanear
  SCANNED // imagen subida, pendiente de procesar
  PROCESSING // procesándose
  GRADED // calificado automáticamente
  REVIEW // necesita revisión manual (QR dañado, marcas ambiguas)
  COMPLETED // revisado y confirmado
}

model StudentAnswer {
  id            String                @id @default(uuid(7)) @db.Uuid
  answerSheetId String                @db.Uuid
  answerSheet   AnswerSheet           @relation(fields: [answerSheetId], references: [id], onDelete: Cascade)
  questionId    String                @db.Uuid
  question      Question              @relation(fields: [questionId], references: [id])
  // Fuente de verdad para hojas de bundle: cada respuesta apunta al item del
  // bundle, que indirectamente da evaluationId + questionId. evaluationId queda
  // como denormalización para queries rápidos y compat con hojas legacy.
  bundleItemId  String?               @db.Uuid
  bundleItem    EvaluationBundleItem? @relation(fields: [bundleItemId], references: [id])
  selectedKey   String? // "A", "B", "C", "D", ..., "H" o null si sin responder
  isCorrect     Boolean?
  isAmbiguous   Boolean               @default(false) // múltiple marca
  confidence    Float? // 0-1 confianza de la detección OMR
  // Sprint 9 OMR auto-detect: diagnóstico por burbuja individual para la UI
  // matriz estilo Remark. Array de {key, fillRatio, state, bboxX/Y/W/H, isMarked}.
  cells         Json?
  fillRatio     Float? // fill ratio de la burbuja seleccionada (atajo para UI)

  @@index([answerSheetId])
  @@index([questionId])
  @@index([bundleItemId])
}

// ========== AUDIT & NOTIFICATIONS ==========

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  action     String // "EVALUATION_CREATED", "EVALUATION_APPROVED", ...
  entityType String // "Evaluation", "Question", "User", ...
  entityId   String   @db.Uuid
  metadata   Json? // {changes: {field: {from, to}}}
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String? // ej: /teacher/evaluations/{id}
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

/**
 * Job asíncrono de extracción IA de preguntas desde PDF.
 * El docente sube el PDF vía `/api/import/upload`, el server action lo
 * guarda en `imports/{institutionId}/{jobId}.pdf` y crea esta fila con
 * `status=QUEUED`. Un worker BullMQ (`workers/question-extract.worker.ts`)
 * la toma, ejecuta `saber-extractor.extractExam()` con extracción de figuras
 * y al terminar guarda el `FinalOutput` serializado en `resultJson` con
 * `status=DONE`. La UI del docente sigue el progreso vía SSE
 * (`/api/import/[jobId]/stream`).
 * El PDF temporal se borra del storage institucional al terminar el job
 * (exitoso o fallido); los huérfanos los barre un cron diario (ver
 * `deploy/scripts/cleanup-imports.sh`).
 */
model QuestionImportJob {
  id              String   @id @default(uuid(7)) @db.Uuid
  institutionId   String   @db.Uuid
  uploadedById    String   @db.Uuid
  /// Evaluación destino si la importación va a un BORRADOR concreto.
  evaluationId    String?  @db.Uuid
  /// QUEUED | PROCESSING | DONE | FAILED
  status          String
  /// Path dentro de STORAGE_DIR: `imports/{institutionId}/{id}.pdf`.
  pdfRelativePath String
  /// FinalOutput serializado de saber-extractor. Solo presente cuando status=DONE.
  resultJson      Json?
  /// Warnings globales del pipeline: missingNumbers, figuras fallidas, etc.
  warningsJson    Json?
  errorMessage    String?
  /// Correlación con BullMQ: jobId en la cola `question-extract`.
  bullJobId       String?  @unique
  /// Última fase reportada por el pipeline (split | extract | solve | images | assemble | uploading).
  progressPhase   String?
  progressDone    Int?
  progressOf      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId, uploadedById])
  @@index([status])
  @@index([createdAt])
}

enum NotificationType {
  EVALUATION_PENDING_REVIEW
  EVALUATION_APPROVED
  EVALUATION_REJECTED
  SCANNING_COMPLETED
  SCANNING_ERROR
  NEW_STUDENT_ASSIGNED
}
